{
  "family": "tactic-tile",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "4096",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::924818964184:role/ecsTaskExecutionRole",
  "volumes": [
    {
      "name": "efs-shared",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-07fdfb9c7048bb6fc",
        "transitEncryption": "ENABLED",
        "authorizationConfig": { "iam": "DISABLED" }
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "tactic_tile",
      "image": "924818964184.dkr.ecr.us-east-2.amazonaws.com/tactic-tile:x86",
      "essential": true,
      "linuxParameters": { "initProcessEnabled": true },
      "environment": [
        { "name": "PYTHONUNBUFFERED", "value": "0" },

        { "name": "HF_HOME",      "value": "/mnt/efs/cache/hf" },
        { "name": "TORCH_HOME",   "value": "/mnt/efs/cache/torch" },
        { "name": "NLTK_DATA",    "value": "/mnt/efs/cache/nltk" },
        { "name": "MPLCONFIGDIR", "value": "/mnt/efs/cache/matplotlib" },
        { "name": "MYDISK_ROOT",  "value": "/mnt/efs/users" },

        { "name": "USE_WAIT_TASKS", "value": "True" },
        { "name": "IS_PSEUDO_TILE", "value": "False" }

      ],
      "mountPoints": [
        { "sourceVolume": "efs-shared", "containerPath": "/mnt/efs", "readOnly": false }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tactic-tile",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "tile"
        }
      }
    }
  ]
}