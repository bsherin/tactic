ARG BASE_IMAGE
FROM ${BASE_IMAGE}
WORKDIR /build

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_INPUT=1

COPY ./wheels_env/requirements.txt .

# Build toolchain for packages that need native build (regex, hdbscan, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential gcc g++ \
      libffi-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Make sure wheel/build tooling is fresh
RUN python -m pip install --upgrade pip setuptools wheel "numpy<3" cython

# ⬇️ Build a COMPLETE wheelhouse (includes transitive dependencies).
#    --prefer-binary: try to use prebuilt wheels instead of building from source.
RUN pip wheel --prefer-binary -r requirements.txt -w /wheelhouse

# (Optional) sanity check – list a few to confirm deps like Jinja2/MarkupSafe are present
RUN ls -lah /wheelhouse | sed -n '1,120p'