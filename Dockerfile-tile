ARG BASE_IMAGE
ARG WHEELS_IMAGE

FROM ${WHEELS_IMAGE} AS wheels

FROM ${BASE_IMAGE} AS app
WORKDIR /code

RUN apt-get update && apt-get install -y --no-install-recommends \
      libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=wheels /wheelhouse /wheelhouse

RUN ls -lah /wheelhouse

COPY --from=wheels /wheelhouse /wheelhouse

RUN set -eu; \
    echo "== Python/pip versions =="; python -V; pip -V; \
    echo "== Listing /wheelhouse =="; ls -lah /wheelhouse || true; \
    find /wheelhouse -maxdepth 1 -type f \( -name '*.whl' -o -name '*.tar.gz' \) > /tmp/wheels.txt; \
    if [ -s /tmp/wheels.txt ]; then \
      echo "== Will install these =="; cat /tmp/wheels.txt; \
      xargs -a /tmp/wheels.txt pip install --no-cache-dir --no-index --find-links=/wheelhouse; \
    else \
      echo "== No artifacts found in /wheelhouse =="; \
    fi

ADD ./tactic_dark.mplstyle /usr/local/lib/python3.11/site-packages/matplotlib/mpl-data/stylelib/

COPY ./tile_container_env ./shared_python/volume_manager.py ./shared_python/exception_mixin.py \
     ./shared_python/redis_tools.py ./shared_python/qworker.py ./shared_python/rabbit_manage.py \
     ./shared_python/communication_utils.py /code/

RUN mkdir -p /root/nltk_data

# Keep defaults; ECS task will override these to EFS paths
ENV HF_HOME=/var/cache/hf \
    TRANSFORMERS_CACHE=/var/cache/hf/transformers \
    NLTK_DATA=/root/nltk \
    MPLCONFIGDIR=/var/cache/matplotlib \
    TORCH_HOME=/var/cache/torch

# --- New: copy entrypoint and use ENTRYPOINT + keep your original CMD ---
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
ENTRYPOINT ["/app/entrypoint.sh"]

CMD ["python", "-u", "tile_main.py"]